---
import Icon from './Icon.astro';
import StrokeRing from './StrokeRing.astro';
interface Props { icon: string; label: string; href?: string }
const { icon, label, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class="contact-link flex items-center" href={href}>
  <span class="contact-link__icon flex shrink-0 items-center justify-center"><StrokeRing /><Icon class="contact-link__glyph" name={icon} /></span>
  <span class="contact-link__label">{label}</span>
</Tag>
<style>
  .contact-link { min-height: max(44px, calc(40 * var(--u))); gap: calc(11 * var(--u)); border-bottom: 1px solid var(--color-line); }
  .contact-link:last-child { border-bottom: 0; }
  .contact-link__icon { position: relative; color: #64232a; width: calc(29 * var(--u)); height: calc(29 * var(--u)); transition: color 180ms ease; }
  .contact-link__icon :global(.contact-link__glyph) { width: calc(15 * var(--u)); height: calc(15 * var(--u)); color: #bbb; }
  .contact-link__label { color: #b6b6b6; font-size: max(10px, calc(8 * var(--u))); line-height: 1.4; overflow-wrap: anywhere; transition: color 180ms ease; }
  a.contact-link:is(:hover, :focus-visible) .contact-link__label { color: var(--color-text); }
  a.contact-link:is(:hover, :focus-visible) .contact-link__icon { color: var(--color-accent-text); }
  @media (max-width: 599px) {
    .contact-link { min-height: 57px; gap: 14px; }
    .contact-link__icon { width: 35px; height: 35px; }
    .contact-link__icon :global(.contact-link__glyph) { width: 17px; height: 17px; }
    .contact-link__label { font-size: 12px; }
  }
</style>
