---
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---
<svg class={`stroke-ring ${className}`} viewBox="0 0 40 40" fill="none" aria-hidden="true" focusable="false">
  <circle cx="20" cy="20" r="19" stroke="currentColor" stroke-width="1" />
</svg>
<style>.stroke-ring { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }</style>
