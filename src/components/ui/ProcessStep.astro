---
import Icon from "./Icon.astro";
import StrokeRing from "./StrokeRing.astro";
import type { Process } from "../../data/portfolio";
interface Props {
  step: Process;
}
const { step } = Astro.props;
---

<li class="process-step grid items-start">
  <span class="process-step__number" aria-hidden="true">
    {step.number}
  </span>
  <span class="process-step__icon flex items-center justify-center">
    <StrokeRing />
    <Icon class="process-step__glyph" name={step.icon} />
    <svg
      class="process-step__connector"
      viewBox="0 0 1 12"
      preserveAspectRatio="none"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M.5 0V12" stroke="currentColor" />
    </svg>
  </span>
  <div class="process-step__content">
    <h3 class="process-step__title">{step.title}</h3>
    <p class="process-step__description">{step.description}</p>
  </div>
</li>
<style>
  .process-step {
    grid-template-columns: calc(17 * var(--u)) calc(35 * var(--u)) 1fr;
    column-gap: calc(12 * var(--u));
    min-height: calc(47 * var(--u));
  }
  .process-step__number {
    font-family: var(--font-narrow);
    font-size: calc(17 * var(--u));
    color: var(--color-accent-text);
    padding-top: calc(7 * var(--u));
    line-height: 1;
  }
  .process-step__icon {
    position: relative;
    width: calc(35 * var(--u));
    height: calc(35 * var(--u));
    color: #652029;
  }
  .process-step__icon :global(.process-step__glyph) {
    width: calc(18 * var(--u));
    height: calc(18 * var(--u));
    color: #bbb;
  }
  .process-step__connector {
    position: absolute;
    top: 100%;
    left: 50%;
    width: 1px;
    height: calc(12 * var(--u));
    pointer-events: none;
  }
  .process-step:last-child .process-step__connector {
    display: none;
  }
  .process-step__content {
    padding-top: calc(4 * var(--u));
  }
  .process-step__title {
    color: var(--color-accent-text);
    font-size: calc(8.4 * var(--u));
    line-height: 1.2;
    font-weight: 500;
  }
  .process-step__description {
    color: var(--color-muted);
    font-size: calc(9 * var(--u));
    line-height: 1.35;
    max-width: calc(138 * var(--u));
    margin-top: calc(2 * var(--u));
  }
  @media (max-width: 599px) {
    .process-step {
      grid-template-columns: 22px 42px 1fr;
      gap: 16px;
      min-height: 69px;
    }
    .process-step__number {
      font-size: 22px;
      padding-top: 10px;
    }
    .process-step__icon {
      width: 42px;
      height: 42px;
    }
    .process-step__icon :global(.process-step__glyph) {
      width: 21px;
      height: 21px;
    }
    .process-step__connector {
      height: 27px;
    }
    .process-step__content {
      padding-top: 5px;
    }
    .process-step__title {
      font-size: 11px;
    }
    .process-step__description {
      max-width: 230px;
      font-size: 12px;
      margin-top: 3px;
    }
  }
</style>
