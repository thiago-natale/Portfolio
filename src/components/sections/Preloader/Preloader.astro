---
import BrandMark from "../../ui/BrandMark.astro";
import { portfolio } from "../../../data/portfolio";
import "./preloader.css";
---

<div
  class="preloader"
  aria-hidden="true"
  data-stage="pending"
  data-ready-label={portfolio.preloader.ready}
>
  <div class="preloader__curtain preloader__curtain--left" aria-hidden="true">
  </div>
  <div class="preloader__curtain preloader__curtain--right" aria-hidden="true">
  </div>
  <div class="preloader__composition">
    <div class="preloader__mark">
      <BrandMark class="preloader__outline" />
      <BrandMark class="preloader__ink" />
    </div>
    <p
      class="preloader__status"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
      {portfolio.preloader.preparing}
    </p>
  </div>
  <button class="preloader__skip" type="button"
    >{portfolio.preloader.skip}
    <svg
      viewBox="0 0 24 24"
      width="24"
      height="24"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"><path d="M4 20L20 4M5 4H20V19"></path></svg
    ></button
  >
</div>
