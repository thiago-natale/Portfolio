{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "prebuild": "node scripts/sync-pdfjs-assets.mjs",
    "preview": "astro preview",
    "brand:sync": "node scripts/sync-brand.mjs",
    "pdf:sync": "node scripts/sync-pdfjs-assets.mjs",
    "format": "prettier --ignore-path .prettierignore --write \"src/**/*.{astro,ts,js,mjs,cjs,css,json}\" \"scripts/**/*.{js,mjs,cjs,ts}\" \"*.{js,mjs,cjs,json}\" \".prettierrc.json\"",
    "format:check": "prettier --ignore-path .prettierignore --check \"src/**/*.{astro,ts,js,mjs,cjs,css,json}\" \"scripts/**/*.{js,mjs,cjs,ts}\" \"*.{js,mjs,cjs,json}\" \".prettierrc.json\"",
    "lint": "eslint src scripts astro.config.mjs eslint.config.mjs",
    "lint:fix": "npm run lint -- --fix",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.3.7",
    "gsap": "^3.15.0",
    "pdfjs-dist": "^6.4.299",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript-eslint": "^8.71.2"
  }
}
